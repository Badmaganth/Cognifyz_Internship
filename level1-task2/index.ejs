<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Task 2 - Form Validation</title>
  <style>
    body { font-family: Arial, sans-serif; max-width: 760px; margin: 40px auto; padding: 0 18px; color: #222; }
    form { display: grid; gap: 12px; padding: 20px; border: 1px solid #ddd; border-radius: 8px; }
    label { font-weight: 600; }
    input, button { font: inherit; padding: 10px; }
    button { cursor: pointer; background: #1f5eff; color: white; border: 0; border-radius: 5px; }
    .hint { color: #555; font-size: .9rem; }
    .errors { background: #fff0f0; padding: 12px 30px; border-radius: 5px; }
    .success { background: #eefaf0; padding: 12px; border-radius: 5px; }
    table { border-collapse: collapse; width: 100%; margin-top: 16px; }
    th, td { border: 1px solid #ddd; padding: 8px; text-align: left; }
  </style>
</head>
<body>
  <h1>Task 2: Form Interaction and Server-Side Validation</h1>
  <p>Client-side JavaScript provides immediate feedback; Express validates submitted data again on the server.</p>

  <% if (typeof successMessage !== "undefined") { %>
    <p class="success"><%= successMessage %></p>
  <% } %>
  <% if (errors.length > 0) { %>
    <div class="errors"><strong>Please correct the following:</strong>
      <ul><% errors.forEach(error => { %><li><%= error %></li><% }); %></ul>
    </div>
  <% } %>

  <form id="registrationForm" action="/register" method="POST">
    <label for="name">Name</label>
    <input id="name" name="name" type="text" value="<%= formData.name %>" minlength="2" required>
    <small class="hint">Enter at least 2 characters.</small>
    <label for="email">Email</label>
    <input id="email" name="email" type="email" value="<%= formData.email %>" required>
    <label for="age">Age</label>
    <input id="age" name="age" type="number" value="<%= formData.age %>" min="18" max="100" required>
    <p id="clientMessage" class="hint" aria-live="polite"></p>
    <button type="submit">Register</button>
  </form>

  <h2>Temporarily Stored Submissions</h2>
  <% if (submissions.length === 0) { %>
    <p>No valid submissions yet.</p>
  <% } else { %>
    <table>
      <thead><tr><th>Name</th><th>Email</th><th>Age</th><th>Submitted</th></tr></thead>
      <tbody><% submissions.forEach(item => { %>
        <tr><td><%= item.name %></td><td><%= item.email %></td><td><%= item.age %></td><td><%= item.submittedAt %></td></tr>
      <% }); %></tbody>
    </table>
  <% } %>

  <script>
    const form = document.getElementById("registrationForm");
    const message = document.getElementById("clientMessage");

    form.addEventListener("input", () => {
      const name = document.getElementById("name").value.trim();
      const email = document.getElementById("email").value.trim();
      const age = Number(document.getElementById("age").value);

      if (name.length < 2) message.textContent = "Name must contain at least 2 characters.";
      else if (!email.includes("@") || !email.includes(".")) message.textContent = "Please enter a valid email address.";
      else if (!Number.isInteger(age) || age < 18 || age > 100) message.textContent = "Age must be between 18 and 100.";
      else message.textContent = "Looks good. Submit to validate on the server.";
    });
  </script>
</body>
</html>
